PROJECT_NAME="Codehunt v2 - Ocean Literacy Decision Platform"
ENV="development"
DEBUG=true

# Database (SQLite default for zero-friction local run; drop-in Postgres/Supabase URL for prod)
DATABASE_URL="sqlite:///./codehunt.db"

# JWT Secret
SECRET_KEY="your-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
TAVILY_API_KEY="your_tavily_api_key_here"

# Ocean Data Adapter (simulated | live_incois)
OCEAN_DATA_PROVIDER="simulated"
